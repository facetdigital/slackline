# Slackline configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Slackline reads credentials in this precedence order:
#   1. SLACK_USER_TOKEN environment variable        <- primary, and the only one
#                                                      headless agents should rely on
#   2. macOS Keychain   (service "slackline")
#   3. 1Password         (SLACKLINE_OP_REF, requires an interactive TouchID prompt)
#   4. ./.env in the current directory              <- lowest precedence, development only
# An explicit --token-file PATH overrides all of these when given.
#
# There is deliberately no --token flag. Tokens in argv are visible to any
# process on the machine via ps, and land in shell history.

# Slack user token (xoxp-). Acts as you, with your access and nothing more.
#
# Required user token scopes for the read-only tools:
#   channels:read   channels:history    public channels
#   groups:read     groups:history      private channels you are in
#   im:read         im:history          direct messages
#   mpim:read       mpim:history        group direct messages
#   users:read                          resolving user IDs to names
#
# Not required by slackline-read, and deliberately not requested:
#   search:read     (planned for `slackline-read search`, a later phase)
#   any :write scope whatsoever
SLACK_USER_TOKEN=xoxp-your-user-token-here

# Optional. 1Password secret reference used as a fallback credential source.
# Requires the `op` CLI and an interactive TouchID prompt, so it is a convenience
# for humans at a terminal, never a path a headless agent should depend on.
#SLACKLINE_OP_REF=op://Vault/Slack User API Token/credential
#SLACKLINE_OP_ACCOUNT=your.1password.com

# Optional. Override the cache directory. Defaults to ~/.cache/slackline.
#SLACKLINE_CACHE_DIR=/path/to/cache

# Optional. Override the audit log path. Defaults to
# ~/.local/state/slackline/audit.jsonl. Set to "none" to disable auditing.
#SLACKLINE_AUDIT_LOG=/path/to/audit.jsonl
